{
  "info": {
    "name": "Fintech API UTN Java 21",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Ana García\",\n  \"email\": \"ana@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Consultar usuario",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuarios/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuarios",
            "1"
          ]
        }
      }
    },
    {
      "name": "Crear cuenta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"numero\": \"CTA-000001\",\n  \"alias\": \"mi.cuenta\",\n  \"moneda\": \"ARS\",\n  \"usuarioId\": 1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Listar cuentas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas"
          ]
        }
      }
    },
    {
      "name": "Consultar cuenta",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas",
            "1"
          ]
        }
      }
    },
    {
      "name": "Actualizar cuenta (BONUS)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas",
            "1"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"alias\": \"nuevo.alias\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Depositar",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas/1/depositos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas",
            "1",
            "depositos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"monto\": 100\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Extraer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas/1/extracciones",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas",
            "1",
            "extracciones"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"monto\": 25\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Cerrar cuenta (BONUS)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/cuentas/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cuentas",
            "1"
          ]
        }
      }
    }
  ]
}
